# Firebase Configuration Template
# Copy this to .env and fill in your values
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Audiomack API Configuration
AUDIOMACK_API_KEY=

# Audius uses its public discovery API; no API key is required.
# Set this to the reachable base URL of the Express backend.
# Android emulator: http://10.0.2.2:3001
# iOS simulator: http://localhost:3001
# Physical device: http://<computer-LAN-IP>:3001 (same Wi-Fi; allow port 3001 through firewall)
AUDIO_API_BASE_URL=

# MusicAPI Core (server-side credentials only)
# The MusicAPI account slug is public. Never put the Client Secret in the app.
MUSICAPI_ACCOUNT_SLUG=
MUSICAPI_CLIENT_ID=
MUSICAPI_CLIENT_SECRET=
# Generate a random secret of at least 32 characters for signing app-bound connections.
MUSICAPI_SESSION_SECRET=

# Google Sign-In Configuration
# Get your Web Client ID from Firebase Console -> Authentication -> Sign-in method -> Google (or Google Cloud Credentials)
GOOGLE_WEB_CLIENT_ID=
# Optional iOS OAuth client ID from Google Cloud Console
GOOGLE_IOS_CLIENT_ID=

# Gemini recommendations (backend .env only; never bundle this key in the mobile app)
GEMINI_API_KEY=
# Optional: pin a specific model. Default preference order: gemini-3.8-flash → gemini-3.7-flash → gemini-2.5-flash-lite → gemini-2.5-flash
# SERVER_FIREBASE_API_KEY is used by the backend to verify user tokens (same value as FIREBASE_API_KEY above).
SERVER_FIREBASE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
